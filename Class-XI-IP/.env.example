# IP Learn — API Keys (copy this file to .env and fill in your keys)
# At least one key enables the AI Tutor. All other features work without any key.

# Google Gemini (FREE — https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Anthropic Claude (optional — https://console.anthropic.com)
ANTHROPIC_API_KEY=

# OpenAI (optional — https://platform.openai.com/api-keys)
OPENAI_API_KEY=
